# Copie para .env antes do deploy e informe o dominio real do frontend.
EXPORTAI_CORS_ORIGINS=https://seu-frontend.example.com
EXPORTAI_CORS_ORIGIN_REGEX=https://(.*\.)?lovable\.app|https://lovable\.dev
EXPORTAI_AI_PROVIDER=groq
EXPORTAI_AI_TIMEOUT_SECONDS=12
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
